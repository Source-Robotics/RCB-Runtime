<gripper name="MSG_medium_motor_200mm_rail">
    <CAN_gripper>1</CAN_gripper>   <!-- 1 = CAN-driven motor gripper -->
    <driver_type>stepfoc</driver_type>  <!-- Driver board firmware product: stepfoc | spectral-bldc. Used to refuse a mismatched firmware image (docs/firmware_flashing.md). -->
    <tool_id>32</tool_id>  <!-- What the gripper's drive is built into (its parameter 1, firmware 109+): 1 = SSG-48; an MSG 11-33 = tens the rail (1/2/3 = 100/150/200 mm), units the motor (1/2/3 = small 21.5 / medium 40 / large 60 mm). RTI compares the drive's with this one: another = GRIPPER_TOOL_MISMATCH, the arm cannot be enabled; 0 = not stored yet (the Gripper tab stores it). 2026-11-17. -->
    <hardware_revision>v1.0</hardware_revision>  <!-- This gripper's hardware revision (2026-10-21, versioning V4): the Versions card and get_versions show it. -->
    <not_measured>Stroke kt gains mass com inertia</not_measured>  <!-- 2026-11-19 (review K4): its motor's Kt and gains, its jaw travel and its mass properties were never measured: placeholders (the Kt 0.111, the pre-2026-10-09 gains, the SSG48's or another variant's mass). The robot's configuration check warns while this gripper is active; remove a word once it is measured -->
    <Stroke>200</Stroke>       <!-- Stroke in mm -->
    <kt>0.111</kt>                 <!-- Torque constant in Nm/A TODO: verify for medium motor -->
    <Ilim>1700</Ilim>              <!-- Current limit in mA -->
    <voltage_limit>6000</voltage_limit>  <!-- Voltage limit in mV (0 = use VBUS). Requires motor firmware that supports it. -->
    <Velocity_limit>80000</Velocity_limit>
    <watchdog_rate>5000</watchdog_rate>   <!-- Motor velocity limit in ticks/s -->
    <KPP>5</KPP>
    <KPV>0.015</KPV>
    <KIV>0.0005</KIV>
    <KIIQ>1</KIIQ>
    <KPIQ>7</KPIQ>
    <KP>0.12</KP>
    <KD>0.002</KD>
    <Gear_r>0.0083</Gear_r>

    <arm_joint_home_offsets>
        <joint id="4">-2.070</joint>   <!-- J5: homes against gripper lower arm — offset depends on gripper dimensions -->
    </arm_joint_home_offsets>

    <!-- Homing configuration -->
    <homing_speed>7000</homing_speed>
    <homing_direction>0</homing_direction>
    <homing_current_ma>700</homing_current_ma>
    <has_hall_sensor>0</has_hall_sensor>
    <home_offset>0.0</home_offset>
    <homing_timeout_s>8.0</homing_timeout_s>
    <!-- 2026-11-19 (review K4): copied from MSG_small_motor_150mm_rail.xml, where it was measured (2026-10-09): how
         long homing waits after the firmware calibrate command before it accepts "calibrated". It must cover a WHOLE
         calibration (the firmware keeps the old "calibrated" while it recalibrates; an abandoned one made every 12th
         homing fail). ~4.5 s measured on that gripper; missing -> 2.0 s. -->
    <homing_calibration_wait_s>5.5</homing_calibration_wait_s>
    <homing_two_pass>1</homing_two_pass>
    <homing_two_pass_max_diff>200</homing_two_pass_max_diff>
    <homing_backoff_s>0.8</homing_backoff_s>
    <homing_order>7</homing_order>

    <!-- Kinematic / dynamics parameters — used by PAR6.py to build the DH tool link -->
    <kinematics>
        <d>-0.1409</d>                                                                    <!-- DH link offset [m] — the MSG's TCP; every MSG variant shares it (user, 2026-10-15) -->
        <a>-0.02835</a>                                                                         <!-- DH link length [m] -->
        <alpha>3.141592653589793</alpha>                                                   <!-- DH twist angle [rad] -->
        <mass>0.41484</mass>                                                               <!-- total mass [kg] TODO: measure -->
        <com>0.00001 -0.00012 -0.03721</com>                                              <!-- center of mass x y z [m] TODO: measure -->
        <inertia>3.2619e-4 2.2519e-4 2.8541e-4 -3.917e-7 -1.2089e-6 -2.998e-7</inertia> <!-- Ixx Iyy Izz Ixy Iyz Ixz[kg·m²] -->
        <Jm>1.5e-6</Jm>                                                                   <!-- motor inertia [kg·m²] -->
        <G>10</G>                                                                          <!-- gear ratio -->
        <B>1e-4</B>                                                                        <!-- viscous friction [N·m·s/rad] -->
        <Tc>0.02 -0.02</Tc>                                                               <!-- Coulomb friction [+, -] [N·m] -->
        <qlim_deg>-160 160</qlim_deg>                                                     <!-- joint limits [deg] -->
    </kinematics>
    <!-- Self-collision (2026-10-06; refitted 2026-10-07 from Source Robotics' PAR6 description package 2.0, par6_msg.urdf):
         the MSG gripper's convex pieces in grippers/MSG_collision.json, J6 joint frame, the jaws over their WHOLE stroke —
         ONE geometry for every MSG rail length for now. The gripper comes within 2.1 mm of wrist 1 (frame 4) at its
         closest, a function of J5/J6 alone, so it can never get closer inside the limits: that pair is not checked. -->
    <collision file="MSG_collision.json">
        <pair with="4" check="off"/>
    </collision>
    <!-- The camera built into the MSG gripper (2026-11-23, TODO/camera_plan.md): the camera server (camera_server.py)
         streams the camera with this USB id when config/system.xml <camera device="auto"> (a gripper without this
         element has no camera). The id is the one unit measured (a generic UVC bridge, MJPEG 1280x720 at 30 fps); a
         batch with another bridge needs its own id here, or <camera device="usb:vvvv:pppp"> in system.xml. frame: the
         camera's optical frame in the PAR6 description (par6_msg.urdf msg_camera_optical_frame). -->
    <camera usb_id="0bda:5844" frame="msg_camera_optical_frame" timing_mode="1280x720@30" timing_readout_us="31814" timing_auto_us="1413.9" timing_run="20261124_200140"/>
</gripper>
