    <safety>
        <!-- Robot-SPECIFIC safety numbers. The safety monitor's on/off switches and time windows are
             <safety_monitor> in config/system.xml (robot-independent policy). The thresholds of the old
             run_safety_checks() were removed with it on 2026-09-30 — that function was never called. -->
        <!-- TCP translational speed limit in m/s, 0 = DISABLED. One number, two consumers:
             the RTI handler's Cartesian velocity cap (prevention, live) and the safety monitor's
             TCP_OVERSPEED check (detection; also off until <safety_monitor><tcp_speed>). Joint
             velocity limits do NOT bound TCP speed near a singularity — that is the case
             this exists for. Shipped 0 until a value is verified on hardware; 1.5 is a
             reasonable first setting for this arm's reach. Runtime override:
             rti_set_tcp_vel_limit over TCP. -->
        <max_tcp_velocity>0</max_tcp_velocity>
        <!-- SOFT_RTI only: the most a streaming PC may widen the command watchdog to, in SECONDS.
             Hard RTI is fixed at 40 ms and can only be tightened; SOFT_RTI is position-only, so
             a stale target converges and holds and a longer window is safe. 0.25 rides out
             ~12 missed commands at 50 Hz. The declared rate always keeps its own 3 intervals
             (5 Hz needs 0.6 s just to be healthy), so this limits EXTRA slack, not the contract.
             Clamped to 0.04 .. 1.0. Runtime request: rti_set_command_timeout. -->
        <max_soft_rti_timeout>0.25</max_soft_rti_timeout>
        <!-- Safety monitor: how far past a SOFT limit the MEASURED position may go before OUT_OF_RANGE
             trips. Smaller than the 5 deg soft-to-hard margin, so an excursion is caught well before
             the endstop. -->
        <joint_limit_tolerance_deg>2.0</joint_limit_tolerance_deg>
        <!-- Safety monitor: how far past a HARD limit (an endstop) the MEASURED position may read before
             BEYOND_ENDSTOP (homing invalidated). Generous on purpose: homing differs between robots and
             an endstop hit hard reads a few degrees past it (J3 read 2.5 deg past after a hand pushed
             through its wall, 2026-10-01). Only a reading no real arm reaches means the reference is wrong. -->
        <endstop_tolerance_deg>10.0</endstop_tolerance_deg>
        <!-- The heaviest part a program may declare with set_payload (kg) — robotclient / dashboard "Payload".
             0.75 kg: the user's working limit for PAR6 (2026-10-04, "for now"); a claim above it is refused
             (PAYLOAD_LIMIT). Missing in a robot XML -> 1.0. -->
        <max_payload_kg>0.75</max_payload_kg>
    </safety>

