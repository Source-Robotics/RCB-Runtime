<robot>

    <name>PAR6</name> <!-- Name of the robot.-->
    <active_gripper>MSG_small_motor_150mm_rail</active_gripper> <!-- FALLBACK only: config/system.xml takes precedence and is what normally selects the gripper. Must match a filename in the grippers/ folder (e.g. MSG_small_motor_150mm_rail -> grippers/MSG_small_motor_150mm_rail.xml). Keep it in step with system.xml — the gripper drives kt, stroke, homing offsets AND the driver_type that firmware flashing checks against. -->
    <server_port>8080</server_port>
    <network_mode>ethernet</network_mode> <!-- Options: ethernet, wifi, offline -->
    <RTI_loop_time>0.004</RTI_loop_time>
    <RTI_Joint_mode_loop_time>0.001</RTI_Joint_mode_loop_time> <!-- What rate to use for a Joint only mode, Ignore ALL Ik, FK, Jacobians; we need super fast loop -->
    <base_transform>1</base_transform> <!-- Is the robot on horizontal table, ceiling, under specific angle  -->
    <gravity_value>9.81</gravity_value> <!-- Gravity value to be used in dynamics calculations. Default is 9.81 m/s^2 -->
    <homing_config>config/PAR6_homing.xml</homing_config> <!-- Separate homing sequence file defining parallel groups and pre-moves -->

    <!-- Pose the arm is moved to before maintenance where the motors LOSE TORQUE
         (firmware flashing). Joint angles in RADIANS, one per joint, in order.
         This is the arm's standby pose: shoulder down, elbow folded back, so the
         structure carries itself instead of the motors. Verified inside every
         soft limit. Matches `qs` in robots/PAR6.py, which is model/test code and
         is not read by anything in production — THIS is the value the runtime
         and the dashboard use. -->
    <park_pose>0.0 -1.5708 3.1416 0.0 0.0 3.1416</park_pose>

    <joints count="6">
        <joint id="0">
            <name>joint1</name>
            <driver_type>stepfoc</driver_type> <!-- Driver board firmware product: stepfoc | spectral-bldc. Used to refuse a mismatched firmware image (docs/firmware_flashing.md). -->
            <kt>0.28</kt> <!-- Torque constant in Nm/A -->
            <Ilim>2400</Ilim>  <!-- 2026-10-09: was 1800 (user's new tune) --> <!-- Current limit in mA -->
            <voltage_limit>6000</voltage_limit>  <!-- Voltage limit in mV (0 = use VBUS). Requires motor firmware that supports it. -->
            <Velocity_limit>88000</Velocity_limit>  <!-- 2026-10-09: was 80000 (user's new tune) --> <!-- (Motor) Velocity limit in ticks/s -->
            <joint_velocity_limit>4.8</joint_velocity_limit> <!-- (Joint) Velocity limit in rad/s -->
            <joint_acceleration_limit>32.0</joint_acceleration_limit> <!-- (Joint) Acceleration limit in rad/s^2. **LIBERAL TEST VALUE 2026-08-06 — was 9.6.** Raised from the velocity/0.5s convention to velocity/0.15s (~3.3x) to open up headroom for finding the real numbers; the physically correct value is (available torque / effective inertia), is pose-dependent, and is still NOT MEASURED. SHARED FIELD: command_executor.py (every EXEC move) and robotics/jog.py (every jog) read this too, so raising it made those ~3.3x punchier as well — it is not RTI-only. Revert with robots/PAR6.xml.conservative-backup. -->
            <joint_jerk_limit>16000.0</joint_jerk_limit> <!-- (Joint) Jerk limit in rad/s^3. **LIBERAL TEST VALUE 2026-08-06 — was 480.0.** Raised from 50x acceleration to 500x. READ THIS: jerk only binds while it is below acceleration_limit/dt, which is 8000.0 rad/s^3 here at 250 Hz — 16000.0 is ABOVE that, so THE JERK LIMIT NO LONGER BINDS AT ALL and acceleration can step to full scale in a single 4 ms tick. That is deliberate: jerk was the sole cause of the RTI tracking lag (0.5-3 deg on smooth streams). It also means jerk limiting is effectively OFF, so gearbox-friendly torque ramping is no longer enforced here. RTI-only field (nothing in EXEC or JOG reads it). Revert with robots/PAR6.xml.conservative-backup. -->
            <torque_rate_limit>364.0</torque_rate_limit> <!-- (Joint) Max rate of change of commanded torque in Nm/s. **LIBERAL TEST VALUE 2026-08-06 — was 36.4.** Raised 10x (11.5x -> 115x peak joint torque). Still far below the electrical ceiling (V/L * kt * gear ~ 3500 Nm/s here), so this remains a motion-smoothness limit rather than a driver limit. RTI-only field. Revert with robots/PAR6.xml.conservative-backup. -->

            <!-- ================= PER-MODE MOTION LIMITS =================
                 The <joint_*_limit> fields above are the HARDWARE CEILING: what the arm
                 survives. Nothing may exceed them — config/xml_parser/robot.py clamps every block
                 below to them on load and warns if one tries to go higher. A mode can only
                 ask for LESS than the hardware allows, never more.

                 Why these exist: acceleration used to be a single number shared by RTI,
                 command_executor and jog, so opening it up for RTI testing made every queued
                 EXEC move ~3.3x punchier as a side effect. Splitting them means the mode
                 being tuned and the mode being used no longer move together.

                 Omit a block, or any field in it, and that mode falls back to the ceiling —
                 so a robot XML written before this still loads and behaves as it always did.
            ============================================================ -->
            <!-- Queued motion (command_executor / trajectory planner). PRE-LIBERAL
                 VALUES: acceleration is velocity/0.5s, exactly what EXEC used before
                 2026-08-06, so pick-and-place behaves as it always has while RTI is tuned.
                 velocity + acceleration only — the planner reads nothing else. -->
            <exec_limits>
                <velocity>4.8</velocity>
                <acceleration>9.6</acceleration>
                <jerk>28.8</jerk> <!-- Jerk in rad/s^3. Was DERIVED in code as RUCKIG_JERK_FACTOR(3.0) x the
                     acceleration limit (motion/planner_pipeline.py) — a limit computed from
                     another limit in consumer code, the exact pattern CLAUDE.md forbids and
                     the same shape as the old MAX_VEL/ACCEL_TIME bug. Stated here instead.
                     This value IS 3.0 x the exec acceleration above, so the switch was
                     behaviour-neutral; it is now a number you can edit rather than one you
                     have to recompute. Only profile='ruckig' bounds jerk at all — trapezoid
                     and toppra STEP acceleration, quintic/s_curve have a fixed shape. -->
            </exec_limits>
            <!-- Streamed external control (RTI / UDP). Currently the full ceiling:
                 RTI is the mode being tuned, and its limiter is what the liberal values were
                 raised for. Lower these rather than the ceiling if RTI alone needs softening. -->
            <rti_limits>
                <velocity>4.8</velocity>
                <acceleration>32.0</acceleration>
                <jerk>16000.0</jerk>
                <torque_rate>364.0</torque_rate>
            </rti_limits>
            <watchdog_rate>5000</watchdog_rate>  <!-- (Motor) Watchdog rate in ms -->
            <!-- 2026-10-09: the user's new tune (dashboard Tune Joint). Was: KPP 5, KPV 0.015, KIV 0.0015, KIIQ 0.9, KPIQ 7 -->
            <KPP>88</KPP> <!-- Kp value for Positon loop of cascade PID controller -->
            <KPV>0.078</KPV> <!-- Kp value for Velocity loop of cascade PID controller -->
            <KIV>0.00012</KIV> <!-- Ki value for Velocity loop of cascade PID controller -->
            <KIIQ>0.1</KIIQ> <!-- Ki value for Current loop of cascade PID controller -->
            <KPIQ>1.5</KPIQ> <!-- Kp value for Current loop of cascade PID controller -->
            <KP>0.12</KP> <!-- KP (Stiffness) value of joint space impedance PD controller -->
            <KD>0.002</KD> <!-- KD (Damping) value of joint space impedance PD controller -->
            <joint_limit_negative>-2.952</joint_limit_negative> <!-- True Joint limits in radians. At this positions robot hits its mechanical limits / endstops-->
            <joint_limit_positive>2.952</joint_limit_positive> <!-- True Joint limits in radians. At this positions robot hits its mechanical limits / endstops-->
            <software_joint_limit_negative>-2.8647335</software_joint_limit_negative> <!-- Soft Joint limits in radians. These limits are imoposed on software to never actually touch the mechanical limits-->
            <software_joint_limit_positive>2.8647335</software_joint_limit_positive> <!-- Soft Joint limits in radians. These limits are imoposed on software to never actually touch the mechanical limits-->
            <tracking_limit_deg>5.0</tracking_limit_deg> <!-- safety monitor TRACKING limit, |commanded - measured| in EXEC; 0 = unchecked. PROVISIONAL 5 deg (2026-10-01, the check runs warn-only): not measured yet — measure like J4-J6 (api_tests/46) and set ~2x the peak. -->
            <hold_oscillation_ma>100</hold_oscillation_ma> <!-- safety monitor HOLD_OSCILLATION_WARNING: fast motor-current ripple (above 25 Hz, mA RMS) while commanded still, for 1.5 s (system.xml); 0 = unchecked. the J3 value; not measured on this joint (record it with api_tests/59 in its freedrive mode). -->
            <encoder>14</encoder> <!-- Encoder resolution in bits.-->
            <sector_home_master_position>3969 </sector_home_master_position> <!-- Encoder ticks the robot is at bootup at MASTER POSITIONS-->
            <sector_home_offset>1.570796327 </sector_home_offset> <!-- Joint level position from master position to the one defined in kinematics chain-->
            <home_offset>2.96279 </home_offset> <!-- joint level position from endstop to the one defined in kinematic chain TODO add another direction also-->
            <calibration_screw_rad>1.570796327</calibration_screw_rad>  <!-- 90 deg. The joint's calibration screw pins it here (user, 2026-10-09): homed and pinned, it should read this angle; api_tests/65_calibration_screws.py measures the difference. -->
            <home_offset_gripper_dependent>0</home_offset_gripper_dependent>   <!-- 1 = use home_offset from the active gripper XML instead of this value -->
            <homing_speed>4500</homing_speed>   <!-- Motor velocity in ticks/s during homing -->
            <homing_direction>0</homing_direction>   <!-- 0=positive motor direction, 1=negative; tune per joint -->
            <homing_current_ma>700</homing_current_ma>   <!-- Current threshold in mA — above this (with stall) = endstop hit -->
            <homing_timeout_s>13</homing_timeout_s>   <!-- Homing timeout in seconds — J0 travels furthest so needs more time -->
            <homing_backoff_s>0.3</homing_backoff_s>   <!-- Time to reverse after hitting endstop (seconds) -->
            <homing_two_pass>1</homing_two_pass>   <!-- 1 = two-pass homing (fast approach + slow re-approach), 0 = single pass -->
            <homing_two_pass_max_diff>3500</homing_two_pass_max_diff>   <!-- Max allowed difference in encoder ticks between pass 1 and pass 2. Exceeding this fails homing. -->
            <has_hall_sensor>0</has_hall_sensor>   <!-- 1 if this joint uses Hall sensor for homing, 0 for endstop/stall -->
            <homing_release_current_ma>300</homing_release_current_ma>   <!-- 2026-10-09 (homing plan H2.3b): was 0 (coast). The coast release gave J1 only sd 0.034 -> 0.025 deg; J5, which pushes INTO its stop (+1500 mA), repeats within +-0.005 deg. +300 mA = a defined push into J1's stop (homing direction positive; its homing current is 700 mA) — the latch is taken at that force. To be measured on the arm. -->
            <homing_release_duration_s>0.5</homing_release_duration_s>   <!-- 2026-10-09 (homing plan H2.3): was NaN (no release). J1 latched in the zero-speed hold after its stall and spread +-0.04 deg with the new PID tune (+-0.01 before); 0.5 s of coast (current 0 above) lets the gearbox unwind from the 700 mA push first. Coast, not a current away from the stop: J1 carries no gravity, so a pull would drift it off the stop. -->
            <homing_release_sample_pct>0.8</homing_release_sample_pct>   <!-- When to latch position: 0.0=start, 0.5=midpoint, 1.0=end of release -->
            <gear_ratio>6.4</gear_ratio> <!-- Gear ratio of the joint -->
            <gear_efficiency>0.98</gear_efficiency> <!-- Gear efficiency of the joint -->
            <dir>0</dir> <!-- is positive rotation of the joint matched to the one in kinematic definiton of the robot 0 yes 1 no -->
            <joint_type>revolute</joint_type> <!-- Type of the joint. Options: revolute, prismatic, continuous_revolute -->
            <friction_static_nm>0</friction_static_nm> <!-- Nm, breakaway friction (not measured yet; api_tests/54, 2026-10-02). 0 = not measured: no friction compensation -->
            <friction_sliding_nm>0.177</friction_sliding_nm> <!-- Nm, SLIDING friction at a steady speed, the lowest at any angle and speed tested (2026-10-02: 0.177-0.218 Nm at 82 / 112 / 142 deg, + 0.09-0.14 Nm.s/rad x speed; api_tests/54). 0 = not measured: 0.7 x breakaway (none if that is 0 too) -->
            <gravity_error_nm>0.035</gravity_error_nm> <!-- Nm, the largest gravity-model error measured WHILE SLIDING, any angle and speed (api_tests/54). Friction compensation gives back 0.5 x (sliding friction - this); J1 carries no gravity: this is direction asymmetry -->
            <freedrive_wall at="auto" frequency_hz="auto" damping_ratio="auto" filter_ms="auto" max_torque_nm="auto" breakthrough_deg="auto" freedrive="warn" scaling="auto"/> <!-- freedrive wall (docs/safety_zones.md §2b); the dashboard's Walls tab writes this -->
        </joint>
