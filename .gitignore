# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Logs (runtime output – don't commit these). Ignore EVERYTHING in logs/
# (.log, rotated .log.1, child .out.log, etc.) but keep the folder via .gitkeep.
logs/*
!logs/.gitkeep

# Runtime / temp data — ignore all generated artifacts, keep the folder.
temp_data/*
!temp_data/.gitkeep

# Supervisor runtime state (user-tweaked settings persisted at runtime)
config/supervisor_settings.json

# Public repo cleanup: keep README public, keep internal markdown local
*.md
!/README.md
# The release files are published with the code (2026-10-21, versioning V5): what changed per version, and which
# client / protocol / firmware / hardware versions work with which runtime.
!/CHANGELOG.md
!/COMPATIBILITY.md
!/VERSIONING.md
!/docstrings_guide.md

# Local/internal docs, planning, assistant instructions, and manual test scripts.
#
# `docs/*` rather than `docs/`: git never descends into an excluded DIRECTORY, so a
# `!docs/<file>` exception below would silently do nothing with the bare form. Excluding
# the directory's CONTENTS instead keeps individual files re-includable.
# Negations must also come after `*.md` above — last matching pattern wins.
docs/*
!docs/pin_map.md
TODO/
dummy_test_scripts/
.github/copilot-instructions.md


# Backup and local IPC/runtime artifacts
*.bak
.lgd-*

# Numpy data files
*.npy
*.npz

# Virtual environments
venv/
.venv/
env/
.env/

# IDEs
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Local working artifacts: pre-change copies of robot configs kept for quick revert
*.conservative-backup

# Temporary cell written (and deleted) by api_tests/50_safety_zones.py; ignored in case it is killed hard
config/cells/api_test_50.xml
config/cells/api_test_51.xml

# Block programs saved on the robot (blockly/programs.py) — user data, local only (TODO/blockly_plan.md D8)
/programs/

# Motor-driver firmware (2026-10-06, user): it lives NEXT to the repo on the robot, outside git's reach; this
# line keeps it out if it is ever moved inside.
motor_driver_stuff/
